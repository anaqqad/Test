# Copy to /opt/blackhistoryroom/.env on the server and fill in (chmod 600). Never commit the real .env.
# website/scripts/make_env.sh generates strong random values for every secret below.
DOMAIN=theblackhistoryroom.com

DB_NAME=bhr_wp
DB_USER=bhr_wp
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
WP_TABLE_PREFIX=bhr_

# First WordPress administrator (used once by WP-CLI at install time)
WP_ADMIN_USER=change-me
WP_ADMIN_EMAIL=you@example.com
WP_ADMIN_PASSWORD=change-me
