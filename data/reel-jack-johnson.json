     0.4
    ]
   }
  },
  {
   "id": "pardon",
   "text": "On May 24, 2018, the President of the United States granted him a pardon.",
   "section": "legacy",
   "visual": {
    "kind": "title",
    "title": "Pardoned",
    "sub": "May 24, 2018"
   }
  },
  {
   "id": "legacy",
   "text": "Champion of the world. Convicted over who he loved. Pardoned seventy-two years too late.",
