 "beats": [
  {
   "id": "hook",
   "text": "The Army said he was too sick to serve. So he rode four hundred ninety-seven miles.",
   "visual": {
    "kind": "photo",
    "image": "colonel2",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.08,
     1.16
    ],
