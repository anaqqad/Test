          "sub": "born 1856"
        }
      }
    },
    {
      "id": "tuskegee",
      "text": "In 1881, he founded Tuskegee Institute in Alabama, and built it into a leading school for Black Americans.",
      "section": "story",
      "visual": {
        "kind": "card",
        "image": "faculty",
        "crop": [
          0.0,
          0.0,
          1.0,
