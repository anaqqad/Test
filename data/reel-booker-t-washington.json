    },
    {
      "id": "born",
      "text": "He was born enslaved in Virginia, and fought for an education after the Civil War.",
      "visual": {
        "kind": "title",
        "title": "1856",
        "sub": "born enslaved in Virginia"
      },
      "overlays": {
        "pin": {
