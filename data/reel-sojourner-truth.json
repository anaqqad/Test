     0.3
    ]
   }
  },
  {
   "id": "akron",
   "text": "In 1851, at a women's rights convention in Akron, Ohio, she gave a speech.",
   "visual": {
    "kind": "title",
    "title": "Akron, 1851",
    "sub": "women's rights convention"
   },
   "overlays": {
    "pin": {
