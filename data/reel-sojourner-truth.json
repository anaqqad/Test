     "sub": "Ulster County"
    }
   }
  },
  {
   "id": "walk",
   "text": "Her enslaver promised to free her, then broke his word. So she walked away to freedom, with her baby daughter.",
   "section": "story",
   "visual": {
    "kind": "photo",
    "image": "cdv",
    "focus": [
     0.4,
     0.3
    ],
    "zoom": [
