     0.32
    ]
   }
  },
  {
   "id": "rename",
   "text": "In 1843, she renamed herself Sojourner Truth, and spoke out against slavery and for women's rights.",
   "visual": {
    "kind": "photo",
    "image": "grandson",
    "focus": [
     0.47,
     0.3
    ],
    "zoom": [
