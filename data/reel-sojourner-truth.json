     1.58
    ],
    "anchor": [
     0.48,
     0.32
    ]
   }
  },
  {
   "id": "peter",
   "text": "Then her five-year-old son, Peter, was sold illegally to a man in Alabama.",
   "visual": {
    "kind": "title",
    "title": "Sold south",
    "sub": "her son Peter, age five"
   }
  },
  {
   "id": "court",
   "text": "In 1828, she took the case to court in New York.",
   "visual": {
    "kind": "title",
    "title": "In court",
    "sub": "New York, 1828"
   }
  },
  {
   "id": "won",
   "text": "And she won. Peter came home.",
   "visual": {
    "kind": "photo",
    "image": "c1864",
    "focus": [
