 "beats": [
  {
   "id": "hook",
   "text": "Hollywood made her a star. Then it filmed her songs so that theaters in the South could cut her out of the movie.",
   "visual": {
    "kind": "photo",
    "image": "p1946",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.4
    ]
   },
   "section": "hook",
   "overlays": {
    "hook": "Hollywood made her a star. *Then filmed her so the South could cut her out.*"
   },
   "captions": false,
   "speed": 1.3
  },
  {
   "id": "name",
   "text": "Her name was Lena Horne.",
   "visual": {
    "kind": "video",
    "clip": "sing1",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.35
    ]
   },
   "section": "who"
  },
  {
   "id": "born",
   "text": "She was born in Brooklyn in 1917. Her father left when she was three, and she was raised mostly by her grandparents.",
   "visual": {
    "kind": "photo",
    "image": "p1941",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "overlays": {
    "pin": {
     "label": "Brooklyn, New York"
    }
   },
   "section": "story"
  },
  {
   "id": "family",
   "text": "Her family were middle-class Black New Yorkers, active in the NAACP.",
   "visual": {
    "kind": "photo",
    "image": "p1947",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.42
    ]
   }
  },
  {
   "id": "cotton",
   "text": "At sixteen she was dancing in the chorus at Harlem's Cotton Club. Black performers on stage, a whites-only audience.",
   "visual": {
    "kind": "video",
    "clip": "stage",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.3
    ]
   },
   "overlays": {
    "stamp": "1933"
   }
  },
  {
   "id": "band",
   "text": "She sang with Noble Sissle's orchestra, then toured with Charlie Barnet's white band.",
   "visual": {
    "kind": "video",
    "clip": "sing2",
    "focus": [
     0.5,
     0.32
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.32
    ]
   }
  },
  {
   "id": "cafe",
   "text": "In 1941 she sang at Cafe Society, New York's first integrated nightclub.",
   "visual": {
    "kind": "video",
    "clip": "cooper2",
    "focus": [
     0.62,
     0.32
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.32
    ]
   }
  },
  {
   "id": "duke",
   "text": "In 1938 she starred in her first feature film, The Duke Is Tops, made for Black audiences.",
   "visual": {
    "kind": "video",
    "clip": "cooper",
    "focus": [
     0.62,
     0.32
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.32
    ]
   },
   "overlays": {
    "lowerThird": {
     "name": "The Duke Is Tops",
     "sub": "1938"
    }
   }
  },
  {
   "id": "mgm",
   "text": "In 1942, MGM signed her to a seven-year contract, almost unheard of for a Black performer at a major studio. The deal said she would not play maids.",
   "visual": {
    "kind": "card",
    "image": "vv1941",
    "caption": "Lena Horne, 1941"
   },
   "overlays": {
    "stamp": "1942"
   },
   "section": "mgm"
  },
  {
   "id": "naacp",
   "text": "The NAACP saw her as a test case for how Hollywood would treat Black women.",
   "visual": {
    "kind": "title",
    "title": "A test case",
    "sub": "for Hollywood"
   }
  },
  {
   "id": "cut",
   "text": "But MGM rarely put her in the story. She sang in her own scenes, apart from the white stars.",
   "visual": {
    "kind": "video",
    "clip": "sing3",
    "focus": [
     0.5,
     0.32
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.32
    ]
   }
  },
  {
   "id": "south",
   "text": "That way, theaters in the South could cut her out, and some did.",
   "visual": {
    "kind": "title",
    "title": "Cut out",
    "sub": "of films shown in the South"
   }
  },
  {
   "id": "stormy",
   "text": "On loan to another studio, she starred in Stormy Weather in 1943. The title song became hers for life.",
   "visual": {
    "kind": "card",
    "image": "stormy",
    "caption": "Stormy Weather, 1943"
   },
   "overlays": {
    "stamp": "1943"
   }
  },
  {
   "id": "war",
   "text": "During the war, she sang for the troops. At one Army camp, German prisoners of war were seated in front of the Black soldiers.",
   "visual": {
    "kind": "card",
    "image": "tuskegee",
    "caption": "Lena Horne with Tuskegee airmen, 1945"
   },
   "section": "war"
  },
  {
   "id": "walked",
   "text": "So she walked off the stage, past the prisoners, and sang to the Black soldiers in the back.",
   "visual": {
    "kind": "video",
    "clip": "sing4",
    "focus": [
     0.5,
     0.32
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.32
    ]
   }
  },
  {
   "id": "julie",
   "text": "When MGM remade Show Boat, the mixed-race role of Julie went to Ava Gardner, a white actress.",
   "visual": {
    "kind": "photo",
    "image": "gottlieb",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.45
    ]
   },
   "section": "after"
  },
  {
   "id": "married",
   "text": "In 1947 she married Lennie Hayton, a white music director. They wed in Paris, because their marriage was against the law in California.",
   "visual": {
    "kind": "card",
    "image": "hayton",
    "caption": "Lena Horne and Lennie Hayton, about 1947"
   }
  },
  {
   "id": "blacklist",
   "text": "In the early 1950s, she was blacklisted for her political ties.",
   "visual": {
    "kind": "photo",
    "image": "p1955",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "overlays": {
    "stamp": "1950s"
   }
  },
  {
   "id": "nightclubs",
   "text": "So she went back to nightclubs, and became one of the biggest singers in America.",
   "visual": {
    "kind": "video",
    "clip": "bwd2",
    "focus": [
     0.55,
     0.35
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.35
    ]
   }
  },
  {
   "id": "jamaica",
   "text": "In 1957 she starred on Broadway, in the musical Jamaica.",
   "visual": {
    "kind": "photo",
    "image": "p1955",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.2,
     1.3
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "overlays": {
    "stamp": "1957"
   }
  },
  {
   "id": "march",
   "text": "In 1963 she marched on Washington for civil rights.",
   "visual": {
    "kind": "card",
    "image": "march",
    "caption": "Lena Horne at the March on Washington, 1963"
   },
   "overlays": {
    "stamp": "August 28, 1963"
   },
   "section": "rights"
  },
  {
   "id": "losses",
   "text": "Then, within two years, she lost her son, her father, and her husband.",
   "visual": {
    "kind": "title",
    "title": "1970 to 1971",
    "sub": "her son, her father, her husband"
   }
  },
  {
   "id": "broadway",
   "text": "In 1981, at sixty-three, she opened her own show on Broadway, Lena Horne: The Lady and Her Music. It won her a special Tony and two Grammys.",
   "visual": {
    "kind": "video",
    "clip": "sing5",
    "focus": [
     0.5,
     0.32
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.32
    ]
   },
   "overlays": {
    "stamp": "1981"
   },
   "section": "end"
  },
  {
   "id": "kennedy",
   "text": "In 1984 she received the Kennedy Center Honors.",
   "visual": {
    "kind": "title",
    "title": "Kennedy Center Honors",
    "sub": "1984"
   }
  },
  {
   "id": "death",
   "text": "Lena Horne died on May 9th, 2010. She was 92.",
   "visual": {
    "kind": "photo",
    "image": "vv1941",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.15,
     1.25
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "overlays": {
    "stamp": "May 9, 2010"
   }
  },
  {
   "id": "close",
   "text": "That was Lena Horne.",
   "visual": {
    "kind": "video",
    "clip": "bwd1",
    "focus": [
     0.55,
     0.35
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.35
    ]
   }
  },
  {
   "id": "cta",
   "text": "Follow The Black History Room for more.",
   "visual": {
    "kind": "endcard"
   },
   "section": "cta",
   "captions": false
  }
 ],
