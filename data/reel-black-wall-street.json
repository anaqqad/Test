 "beats": [
  {
   "id": "hook",
   "text": "They called it Black Wall Street. In less than a day, it was gone.",
   "visual": {
    "kind": "photo",
    "image": "inflames",
    "focus": [
     0.5,
     0.4
    ],
    "zoom": [
     1.08,
     1.16
    ],
