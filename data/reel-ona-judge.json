 "beats": [
  {
   "id": "hook",
   "text": "She ran away from George Washington. And he never stopped hunting her.",
   "visual": {
    "kind": "photo",
    "image": "gw",
    "focus": [
     0.5,
     0.32
    ],
    "zoom": [
     1.08,
     1.18
    ],
    "anchor": [
