 "beats": [
  {
   "id": "hook",
   "text": "She spied on the Nazis for France, with secrets hidden in her sheet music. Then a New York nightclub refused to serve her.",
   "visual": {
    "kind": "photo",
    "image": "vv49",
    "focus": [
     0.5,
     0.25
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.36
    ]
   },
   "section": "hook",
   "overlays": {
    "hook": "She spied on the Nazis for France. *Then New York refused to serve her.*"
   },
   "captions": false,
   "speed": 1.3
  },
  {
   "id": "name",
   "text": "Her name was Josephine Baker. This is her on film, in 1932.",
   "visual": {
    "kind": "video",
    "clip": "talk1",
    "focus": [
     0.5,
     0.2
    ],
    "zoom": [
     1.25,
     1.32
    ],
    "anchor": [
     0.5,
     0.3
    ]
   },
   "section": "who"
  },
  {
   "id": "born",
   "text": "She was born Freda Josephine McDonald, in St. Louis, Missouri, in 1906. As a child, she cleaned houses for white families.",
   "visual": {
    "kind": "photo",
    "image": "manuel",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "overlays": {
    "pin": {
     "label": "St. Louis, Missouri"
    }
   },
   "section": "story"
  },
  {
   "id": "riot",
   "text": "In 1917, at eleven years old, she watched East St. Louis burn, as white mobs attacked Black families.",
   "visual": {
    "kind": "title",
    "title": "1917",
    "sub": "East St. Louis"
   }
  },
  {
   "id": "married",
   "text": "She was married at thirteen. By fifteen she had married again, and she kept her husband's name: Baker.",
   "visual": {
    "kind": "photo",
    "image": "walery30",
    "focus": [
     0.5,
     0.25
    ],
    "zoom": [
     1.1,
     1.2
    ],
    "anchor": [
     0.5,
     0.32
    ]
   }
  },
  {
   "id": "shuffle",
   "text": "She tried out for Shuffle Along, a hit Black musical on Broadway. Producers turned her down, reportedly as too young, too skinny and too dark. She got in as a dresser, and danced her way into the chorus.",
   "visual": {
    "kind": "photo",
    "image": "npg1926",
    "focus": [
     0.5,
     0.42
    ],
    "zoom": [
     1.1,
     1.25
    ],
    "anchor": [
     0.5,
     0.45
    ]
   },
   "section": "break"
  },
  {
   "id": "paris",
   "text": "In 1925, at nineteen, she sailed for Paris. On October 2nd she opened in a new all-Black revue, and Paris went wild.",
   "visual": {
    "kind": "card",
    "image": "poster30",
    "caption": "Casino de Paris poster, 1930"
   },
   "overlays": {
    "stamp": "1925"
   },
   "section": "paris"
  },
  {
   "id": "folies",
   "text": "In 1926 she danced at the Folies Bergère, in a skirt made of bananas.",
   "visual": {
    "kind": "video",
    "clip": "dance_coat",
    "focus": [
     0.36,
     0.3
    ],
    "zoom": [
     1.0,
     1.05
    ],
    "anchor": [
     0.5,
     0.36
    ]
   }
  },
  {
   "id": "dance",
   "text": "Ernest Hemingway called her the most sensational woman anyone ever saw.",
   "visual": {
    "kind": "video",
    "clip": "dance",
    "focus": [
     0.36,
     0.3
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.36
    ]
   }
  },
  {
   "id": "star",
   "text": "She became the most successful American entertainer in France. In 1937 she became a French citizen.",
   "visual": {
    "kind": "video",
    "clip": "walk",
    "focus": [
     0.58,
     0.35
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.4
    ]
   },
   "overlays": {
    "stamp": "1937"
   }
  },
  {
   "id": "war",
   "text": "Then, in 1939, war came. French military intelligence recruited her as a spy.",
   "visual": {
    "kind": "video",
    "clip": "med",
    "focus": [
     0.65,
     0.3
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.38
    ]
   },
   "overlays": {
    "stamp": "1939"
   },
   "section": "war"
  },
  {
   "id": "ink",
   "text": "She wrote secret notes in invisible ink on her sheet music. Others she pinned inside her underwear.",
   "visual": {
    "kind": "video",
    "clip": "talk2",
    "focus": [
     0.5,
     0.2
    ],
    "zoom": [
     1.25,
     1.32
    ],
    "anchor": [
     0.5,
     0.3
    ]
   }
  },
  {
   "id": "uniform",
   "text": "She joined the Free French Air Force as an officer, and sang for Allied troops in North Africa.",
   "visual": {
    "kind": "card",
    "image": "alger44",
    "caption": "Algiers, 1944: Josephine Baker in uniform"
   }
  },
  {
   "id": "medals",
   "text": "France later gave her the Resistance Medal, the War Cross, and the Legion of Honour.",
   "visual": {
    "kind": "card",
    "image": "troops43",
    "caption": "Singing for the troops, 1943"
   }
  },
  {
   "id": "stork",
   "text": "But at home, it was different. In 1951, at New York's Stork Club, she said the staff refused to serve her. Protesters picketed the club.",
   "visual": {
    "kind": "photo",
    "image": "vv51",
    "focus": [
     0.5,
     0.28
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.4
    ]
   },
   "overlays": {
    "stamp": "1951"
   },
   "section": "insult"
  },
  {
   "id": "miami",
   "text": "That same year in Miami Beach, she refused to perform unless Black and white fans could sit together. The club gave in.",
   "visual": {
    "kind": "photo",
    "image": "vv44",
    "focus": [
     0.5,
     0.28
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.4
    ]
   }
  },
  {
   "id": "march",
   "text": "In 1963, at the March on Washington, she stood at the microphone in her French uniform and medals. She was the only woman on the official speaker list.",
   "visual": {
    "kind": "title",
    "title": "1963",
    "sub": "March on Washington"
   },
   "section": "march"
  },
  {
   "id": "coretta",
   "text": "After Martin Luther King was killed, Coretta Scott King reportedly asked her to lead the movement. She said no. Her children were too young to lose their mother.",
   "visual": {
    "kind": "card",
    "image": "rotterdam59",
    "caption": "With her children, Rotterdam, 1959"
   }
  },
  {
   "id": "tribe",
   "text": "She had adopted twelve children. She called them her Rainbow Tribe, and raised them in a castle in France.",
   "visual": {
    "kind": "card",
    "image": "tribe64",
    "caption": "The Rainbow Tribe, Amsterdam, 1964"
   },
   "section": "fall"
  },
  {
   "id": "evicted",
   "text": "But she went broke. In 1969 she was thrown out of her own castle.",
   "visual": {
    "kind": "card",
    "image": "milandes61",
    "caption": "Les Milandes, 1961"
   }
  },
  {
   "id": "bobino",
   "text": "In 1975, with help from Princess Grace of Monaco, she opened a comeback show in Paris. Four days later, she died.",
   "visual": {
    "kind": "card",
    "image": "garden61",
    "caption": "In her garden at Les Milandes, 1961"
   },
   "section": "end"
  },
  {
   "id": "funeral",
   "text": "More than twenty thousand people came to her funeral, and France gave her full military honors.",
   "visual": {
    "kind": "card",
    "image": "moise",
    "caption": "With her son at Les Milandes, 1961"
   }
  },
  {
   "id": "pantheon",
   "text": "In 2021, France placed her in the Panthéon, the first Black woman ever honored there.",
   "visual": {
    "kind": "title",
    "title": "2021",
    "sub": "The Panthéon, Paris"
   },
   "section": "legacy"
  },
  {
   "id": "close",
   "text": "That was Josephine Baker.",
   "visual": {
    "kind": "photo",
    "image": "vv49",
    "focus": [
     0.5,
     0.25
    ],
    "zoom": [
     1.12,
     1.2
    ],
    "anchor": [
     0.5,
     0.36
    ]
   }
  },
  {
   "id": "cta",
   "text": "Follow The Black History Room for more.",
   "visual": {
    "kind": "endcard"
   },
   "section": "cta",
   "captions": false
  }
 ],
