      },
      "section": "who"
    },
    {
      "id": "names",
      "text": "They were Ellen and William Craft, from Georgia.",
      "visual": {
        "kind": "card",
        "image": "couple",
        "crop": [
          0.04,
          0.0,
          0.96,
          0.92
        ],
        "caption": "Ellen and William Craft"
      },
      "overlays": {
        "pin": {
          "label": "Macon",
          "sub": "Georgia"
        }
      }
    },
    {
      "id": "looked",
      "text": "Ellen's father was her white enslaver. She looked white.",
      "visual": {
        "kind": "card",
        "image": "couple",
        "crop": [
          0.06,
          0.0,
          0.48,
          0.75
        ],
        "caption": "Ellen Craft, in later life"
      },
      "section": "story"
    },
    {
      "id": "disguise",
      "text": "She cut her hair, and put on a top hat and green glasses.",
      "visual": {
        "kind": "photo",
        "image": "ellen",
        "focus": [
          0.53,
          0.25
        ],
        "zoom": [
          1.05,
          1.12
        ],
        "anchor": [
          0.45,
          0.3
        ]
      }
    },
    {
      "id": "bandage",
      "text": "She wrapped her face in a bandage, like a sick man,",
      "visual": {
        "kind": "title",
        "title": "The disguise",
        "sub": "a bandage, to hide a face with no beard"
      }
    },
    {
      "id": "sling",
      "text": "and put her right arm in a sling, because she could not write.",
      "visual": {
        "kind": "card",
        "image": "ellen",
        "crop": [
          0.12,
          0.3,
          0.92,
          0.98
        ],
        "caption": "The sling, in the 1860 engraving"
      }
    },
    {
      "id": "train",
      "text": "In December 1848, they boarded a train to Savannah.",
      "visual": {
        "kind": "title",
        "title": "December 1848",
        "sub": "Macon to Savannah, by train"
      },
      "overlays": {
        "pin": {
          "label": "Savannah",
          "sub": "Georgia"
        }
      }
    },
    {
      "id": "friend",
      "text": "A friend of her owner sat down next to her.",
      "visual": {
        "kind": "title",
        "title": "Next seat",
        "sub": "a friend of her owner"
      }
    },
    {
      "id": "deaf",
      "text": "She pretended to be deaf.",
      "visual": {
