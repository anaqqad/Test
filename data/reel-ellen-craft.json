  "facts": [
    {
      "beat": "hook",
      "claim": "In December 1848 Ellen Craft, enslaved, escaped disguised as a white male slaveholder/planter.",
      "sources": [
        "NGE",
        "NPS",
        "NATGEO",
        "HIST"
      ]
    },
    {
      "beat": "husband",
      "claim": "William Craft, her husband, posed as her enslaved servant.",
      "sources": [
        "NGE",
        "NPS",
        "HIST"
      ]
    },
    {
      "beat": "names",
      "claim": "Both were enslaved in Macon, Georgia.",
      "sources": [
        "NGE",
        "NPS"
      ]
    },
    {
      "beat": "looked",
      "claim": "Ellen was the daughter of an enslaved woman and her white enslaver, and looked white.",
      "sources": [
        "NGE",
        "NPS"
      ]
    },
    {
      "beat": "disguise",
      "claim": "She cut her hair short and wore a top hat and green spectacles.",
      "sources": [
        "NPS",
        "NATGEO",
        "NGE"
      ],
      "note": "Green spectacles: NPS, NATGEO. Top hat and short hair: NGE, NATGEO."
    },
    {
      "beat": "bandage",
      "claim": "She bandaged/poulticed her face (hiding a beardless face) as an invalid.",
      "sources": [
        "NPS",
        "HIST",
        "NATGEO"
      ]
    },
    {
      "beat": "sling",
      "claim": "Her right arm in a sling, because she could not write and would be asked to sign.",
      "sources": [
        "NPS",
        "LOC",
        "HIST",
        "NATGEO"
      ]
    },
    {
      "beat": "train",
      "claim": "In December 1848 they took the train from Macon to Savannah.",
      "sources": [
        "NGE",
        "NPS",
        "HIST"
      ],
      "note": "Start date varies: 21 Dec (NPSP, NATGEO), 18-20 Dec (NPS), 24 Dec (LOC). Script says December 1848."
    },
    {
      "beat": "friend",
      "claim": "A friend of Ellen's enslaver sat next to her on the train.",
      "sources": [
        "NPS",
        "LOC",
        "NATGEO"
      ]
    },
    {
      "beat": "deaf",
      "claim": "She pretended to be deaf/hard of hearing to avoid talking to him.",
      "sources": [
        "NPS",
        "NATGEO"
      ]
    },
    {
      "beat": "route",
      "claim": "They travelled north by train and steamboat (Savannah, Charleston, Wilmington, Virginia, Washington, Baltimore).",
      "sources": [
        "NGE",
        "NPS"
      ]
    },
    {
      "beat": "baltimore",
      "claim": "In Baltimore an official stopped them and demanded proof William belonged to Ellen; they were allowed to board.",
      "sources": [
        "NPS",
        "NATGEO"
      ]
    },
    {
      "beat": "christmas",
      "claim": "They reached Philadelphia on Christmas Day 1848.",
      "sources": [
        "NGE",
        "NPSP",
        "LOC",
        "HIST"
      ]
    },
    {
      "beat": "hunters",
      "claim": "In 1850, after the Fugitive Slave Act, slave catchers (Hughes and Knight) came to Boston for them.",
      "sources": [
        "NGE",
        "NPSP",
        "NATGEO"
      ]
    },
    {
      "beat": "england",
      "claim": "They fled to England and published Running a Thousand Miles for Freedom (1860).",
      "sources": [
        "NGE",
        "NPSP",
        "LOC"
      ]
    },
    {
      "beat": "legacy",
      "claim": "'A thousand miles' follows the title of their book; an approximation, not a measured distance.",
      "sources": [
        "RTM",
        "NGE"
      ]
    }
  ],
