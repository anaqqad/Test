        "NEBE",
        "NCC"
      ]
    },
    {
      "beat": "speaker",
      "claim": "Became a leading abolitionist orator.",
      "sources": [
        "NEBE",
        "AWM"
      ]
    },
    {
      "beat": "cartoons",
      "claim": "Images of Black Americans of the time were largely demeaning.",
      "sources": [
        "NPS",
        "AWM"
      ]
    },
    {
      "beat": "sat",
      "claim": "Sat for his portrait whenever he could, from his earliest known photograph (1841) to his death (1895).",
      "sources": [
        "NPS",
        "PBH"
      ]
    },
    {
      "beat": "count",
      "claim": "Photographed more than 160 times.",
      "sources": [
        "AWM",
        "PBH",
        "LJ"
      ]
    },
    {
      "beat": "dignity",
      "claim": "He used portraits to show the dignity denied to the enslaved and to change how Black Americans were seen.",
      "sources": [
        "AWM",
        "PBH",
        "NPS"
      ]
    },
    {
      "beat": "lectures",
      "claim": "He wrote and gave lectures on photography/pictures (e.g. 'Lecture on Pictures').",
      "sources": [
        "PBH",
        "LJ"
      ]
    },
    {
      "beat": "twist",
      "claim": "The most photographed American of the 19th century, more than Lincoln.",
