  "facts": [
    {
      "beat": "hook",
      "claim": "Morgan entered the gas-filled Cleveland waterworks tunnel in July 1916, wearing his safety hood.",
      "sources": [
        "ECH",
        "BRIT",
        "USPTO"
      ]
    },
    {
      "beat": "name",
      "claim": "Garrett A. Morgan, Black inventor in Cleveland, 1877-1963.",
      "sources": [
        "BRIT",
        "USPTO",
        "ECH"
      ]
    },
    {
      "beat": "blast",
      "claim": "On 24 July 1916 an explosion hit a waterworks tunnel being dug under Lake Erie; gas filled it.",
      "sources": [
        "ECH",
        "BRIT",
        "USPTO"
      ]
    },
    {
      "beat": "trapped",
      "claim": "Workers were trapped; would-be rescuers were overcome by the gas and died.",
      "sources": [
        "ECH",
        "USPTO"
      ],
      "note": "ECH: 11 workers + 10 rescuers died; USPTO: 20 lives."
    },
    {
      "beat": "call",
      "claim": "The Cleveland police called Morgan.",
      "sources": [
        "ECH",
        "USPTO"
      ]
    },
    {
      "beat": "patent",
      "claim": "He had patented a breathing device / safety hood in 1914.",
      "sources": [
        "BRIT",
        "USPTO",
        "PAT"
      ]
    },
    {
      "beat": "down",
      "claim": "He and his brother Frank (with others) entered the tunnel wearing the hoods.",
      "sources": [
        "ECH",
        "USPTO"
      ]
    },
    {
      "beat": "survivors",
      "claim": "They brought out survivors.",
      "sources": [
        "ECH",
        "USPTO",
        "BRIT"
      ],
      "note": "Count differs: 2 rescued + 4 bodies (ECH), 8 survivors (USPTO, BRIT). Script gives no number."
    },
    {
      "beat": "denied",
      "claim": "He was denied the money other rescuers received, and his role was left out of national news reports.",
      "sources": [
        "USPTO",
        "BRIT"
      ]
    },
    {
      "beat": "racism",
      "claim": "Racism hurt his hood sales; he hired a white man / white actors as salesmen.",
      "sources": [
        "BRIT",
        "USPTO"
      ]
    },
    {
      "beat": "crash",
      "claim": "After witnessing a collision at an intersection, he patented a traffic signal (US 1,475,024, 20 Nov 1923).",
      "sources": [
        "USPTO",
        "BRIT",
        "HIST",
        "PAT"
      ]
    },
    {
      "beat": "ge",
      "claim": "General Electric bought the rights for $40,000.",
      "sources": [
        "BRIT",
        "USPTO",
        "HIST"
      ]
    }
