 "beats": [
  {
   "id": "hook",
   "text": "He broke baseball's color line. But three years before, the Army put him on trial, for refusing to move to the back of a bus.",
   "visual": {
    "kind": "photo",
    "image": "look55",
    "focus": [
     0.3,
     0.38
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "section": "hook",
   "overlays": {
    "hook": "He broke baseball's color line. *First, the Army put him on trial.*"
   },
   "captions": false,
   "speed": 1.3
  },
  {
   "id": "name",
   "text": "His name was Jackie Robinson. And in 1950, he played himself, in a movie about his own life.",
   "visual": {
    "kind": "video",
    "clip": "film_close",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.2,
     1.28
    ],
    "anchor": [
     0.5,
     0.32
    ]
   },
   "section": "who"
  },
  {
   "id": "born",
   "text": "He was born in 1919 in Cairo, Georgia, the youngest of five children of sharecroppers. His father left the family.",
   "visual": {
    "kind": "title",
    "title": "1919",
    "sub": "Cairo, Georgia"
   },
   "section": "story"
  },
  {
   "id": "pasadena",
   "text": "His mother moved them all to Pasadena, California, and raised them on her own.",
   "visual": {
    "kind": "card",
    "image": "mack49",
    "caption": "Jackie and Mack Robinson with their mother, 1949"
   }
  },
  {
   "id": "mack",
   "text": "His older brother Mack won silver at the 1936 Olympics, in the 200 meters. Right behind Jesse Owens.",
   "visual": {
    "kind": "photo",
    "image": "mack49",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.1,
     1.2
    ],
    "anchor": [
     0.5,
     0.4
    ]
   },
   "overlays": {
    "stamp": "1936"
   }
  },
  {
   "id": "ucla",
   "text": "Jackie went to UCLA, and became its first athlete to letter in four sports.",
   "visual": {
    "kind": "photo",
    "image": "bball",
    "focus": [
     0.5,
     0.25
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.35
    ]
   }
  },
  {
   "id": "army",
   "text": "In 1942 he was drafted. The Army kept Black soldiers out of officer school, until the boxing champion Joe Louis protested. Jackie became a lieutenant.",
   "visual": {
    "kind": "video",
    "clip": "army_film",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.1,
     1.18
    ],
    "anchor": [
     0.5,
     0.34
    ]
   },
   "section": "army"
  },
  {
   "id": "bus",
   "text": "Then, on July 6th, 1944, at an Army base in Texas, a bus driver ordered him to move to the back. He refused.",
   "visual": {
    "kind": "title",
    "title": "July 6, 1944",
    "sub": "Texas"
   },
   "section": "bus"
  },
  {
   "id": "trial",
   "text": "He was arrested and court-martialed. A panel of nine white officers heard the case. They found him not guilty.",
   "visual": {
    "kind": "card",
    "image": "army",
    "caption": "Lieutenant Jack Robinson"
   }
  },
  {
   "id": "monarchs",
   "text": "In 1945 he played for the Kansas City Monarchs, in the Negro leagues.",
   "visual": {
    "kind": "video",
    "clip": "field",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.34
    ]
   },
   "overlays": {
    "stamp": "1945"
   },
   "section": "break"
  },
  {
   "id": "rickey",
   "text": "That August, Branch Rickey of the Brooklyn Dodgers called him in. He told Jackie he needed a player with guts enough not to fight back.",
   "visual": {
    "kind": "video",
    "clip": "rickey",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.1,
     1.18
    ],
    "anchor": [
     0.5,
     0.32
    ]
   }
  },
  {
   "id": "montreal",
   "text": "Rickey signed him. In 1946 he played for the Montreal Royals, and led the whole league in hitting.",
   "visual": {
    "kind": "card",
    "image": "royals46",
    "caption": "Montreal Royals, 1946"
   },
   "overlays": {
    "stamp": "1946"
   }
  },
  {
   "id": "debut",
   "text": "Then, on April 15th, 1947, Jackie Robinson walked onto the field for the Brooklyn Dodgers. The color line was broken.",
   "visual": {
    "kind": "video",
    "clip": "dodgers",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.15,
     1.22
    ],
    "anchor": [
     0.5,
     0.32
    ]
   },
   "overlays": {
    "stamp": "1947"
   },
   "section": "debut"
  },
  {
   "id": "abuse",
   "text": "It was brutal. The Phillies manager and his players screamed racial slurs at him from the dugout.",
   "visual": {
    "kind": "video",
    "clip": "abuse",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.12
    ],
    "anchor": [
     0.5,
     0.34
    ]
   },
   "section": "insult"
  },
  {
   "id": "mail",
   "text": "Hate mail poured in. So did death threats.",
   "visual": {
    "kind": "card",
    "image": "hate",
    "caption": "Hate mail sent to Jackie Robinson, 1947"
   }
  },
  {
   "id": "held",
   "text": "He did not fight back. He answered with his bat, and with his speed.",
   "visual": {
    "kind": "video",
    "clip": "play",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.4
    ]
   }
  },
  {
   "id": "held2",
   "text": "That season, he led the whole National League in stolen bases.",
   "visual": {
    "kind": "video",
    "clip": "dodgers2",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.4
    ]
   }
  },
  {
   "id": "rookie",
   "text": "That year, he won baseball's first Rookie of the Year award. In 1949 he was the league's Most Valuable Player.",
   "visual": {
    "kind": "card",
    "image": "mvp49",
    "caption": "National League MVP, 1949"
   },
   "section": "triumph"
  },
  {
   "id": "series",
   "text": "In 1955, the Dodgers won the World Series.",
   "visual": {
    "kind": "photo",
    "image": "b54",
    "focus": [
     0.45,
     0.28
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.36
    ]
   },
   "overlays": {
    "stamp": "1955"
   }
  },
  {
   "id": "hall",
   "text": "In 1962 he was elected to the Hall of Fame, the first Black player ever inducted.",
   "visual": {
    "kind": "title",
    "title": "1962",
    "sub": "Hall of Fame"
   }
  },
  {
   "id": "march",
   "text": "He kept fighting off the field. In 1963 he marched on Washington, with his son beside him.",
   "visual": {
    "kind": "card",
    "image": "march63",
    "caption": "March on Washington, 1963"
   },
   "section": "later"
  },
  {
   "id": "last",
   "text": "In October 1972 he threw out the first pitch at the World Series. That day, he said he still wanted to see a Black manager in baseball.",
   "visual": {
    "kind": "photo",
    "image": "look55",
    "focus": [
     0.3,
     0.38
    ],
    "zoom": [
     1.1,
     1.2
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "section": "end"
  },
  {
   "id": "died",
   "text": "Nine days later, he died of a heart attack. He was 53.",
   "visual": {
    "kind": "card",
    "image": "family50",
    "caption": "With Rachel and Sharon, 1950"
   }
  },
  {
   "id": "fortytwo",
   "text": "In 1997, baseball retired his number, 42, for every team. Every April 15th, every player wears it.",
   "visual": {
    "kind": "title",
    "title": "42",
    "sub": "Retired by every team"
   },
   "section": "legacy"
  },
  {
   "id": "close",
   "text": "That was Jackie Robinson.",
   "visual": {
    "kind": "photo",
    "image": "npg49",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.1,
     1.18
    ],
    "anchor": [
     0.5,
     0.38
    ]
   }
  },
  {
   "id": "cta",
   "text": "Follow The Black History Room for more.",
   "visual": {
    "kind": "endcard"
   },
   "section": "cta",
   "captions": false
  }
 ],
