 "beats": [
  {
   "id": "hook",
   "text": "He knocked out the Nazis' favorite boxer in two minutes and four seconds. Then his own government chased him for a debt he could never pay.",
   "visual": {
    "kind": "photo",
    "image": "p1935",
    "focus": [
     0.5,
     0.36
    ],
    "zoom": [
     1.1,
     1.2
    ],
    "anchor": [
     0.5,
     0.4
    ]
   },
   "section": "hook",
   "overlays": {
    "hook": "He beat the Nazis' champion in 124 seconds. *Then his own government came for everything.*"
   },
   "captions": false,
   "speed": 1.3
  },
  {
   "id": "name",
   "text": "His name was Joe Louis.",
   "visual": {
    "kind": "title",
    "title": "Joe Louis",
    "sub": "the Brown Bomber"
   },
   "section": "who"
  },
  {
   "id": "born",
   "text": "He was born in Alabama in 1914, the grandson of enslaved people. His parents were sharecroppers. When he was two, his father was sent to a mental hospital.",
   "visual": {
    "kind": "photo",
    "image": "smile1937",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.5
    ]
   },
   "overlays": {
    "pin": {
     "label": "Alabama"
    }
   },
   "section": "story"
  },
  {
   "id": "detroit",
   "text": "In 1926 the family moved north, to Detroit. As an amateur, he won fifty of fifty-four fights.",
   "visual": {
    "kind": "photo",
    "image": "fist1937",
    "focus": [
     0.55,
     0.4
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.55,
     0.5
    ]
   },
   "overlays": {
    "stamp": "1926"
   }
  },
  {
   "id": "rules",
   "text": "When he turned pro, his managers gave him rules. Never be photographed with a white woman. Never gloat over a beaten opponent.",
   "visual": {
    "kind": "title",
    "title": "The rules",
    "sub": "set by his managers"
   }
  },
  {
   "id": "why",
   "text": "The last Black champion, Jack Johnson, had enraged white America. They wanted to give no one an excuse.",
   "visual": {
    "kind": "photo",
    "image": "vanvechten",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.45
    ]
   }
  },
  {
   "id": "loss",
   "text": "In 1936 he fought the German Max Schmeling, and was knocked out in the twelfth round.",
   "visual": {
    "kind": "card",
    "image": "loss1936",
    "caption": "Louis counted out against Schmeling, 1936"
   },
   "overlays": {
    "stamp": "1936"
   },
   "section": "fall"
  },
  {
   "id": "nazi",
   "text": "In Germany, the Nazi regime turned Schmeling into a national hero.",
   "visual": {
    "kind": "title",
    "title": "A Nazi hero",
    "sub": "Max Schmeling, 1936"
   }
  },
  {
   "id": "title",
   "text": "A year later, Louis won the heavyweight title in Chicago, the first Black heavyweight champion in twenty-two years.",
   "visual": {
    "kind": "video",
    "clip": "braddock",
    "focus": [
     0.5,
     0.45
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.45
    ]
   },
   "overlays": {
    "stamp": "June 22, 1937"
   }
  },
  {
   "id": "rematch",
   "text": "Then came the rematch. June 22nd, 1938, Yankee Stadium. Seventy thousand people. Millions more on the radio, in America and in Germany.",
   "visual": {
    "kind": "video",
    "clip": "ring38a",
    "focus": [
     0.5,
     0.42
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.42
    ]
   },
   "section": "rematch",
   "overlays": {
    "stamp": "June 22, 1938"
   }
  },
  {
   "id": "fight",
   "text": "Louis came out punching, and never stopped.",
   "visual": {
    "kind": "video",
    "clip": "ring38b",
    "focus": [
     0.5,
     0.42
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.42
    ]
   }
  },
  {
   "id": "ko",
   "text": "Schmeling went down. His corner threw in the towel. It was over in two minutes and four seconds.",
   "visual": {
    "kind": "video",
    "clip": "down38",
    "focus": [
     0.5,
     0.6
    ],
    "zoom": [
     1.05,
     1.12
    ],
    "anchor": [
     0.5,
     0.6
    ]
   }
  },
  {
   "id": "harlem",
   "text": "In Harlem, people poured into the streets.",
   "visual": {
    "kind": "photo",
    "image": "harlem",
    "focus": [
     0.5,
     0.45
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.45
    ]
   }
  },
  {
   "id": "reign",
   "text": "He held the title for almost twelve years and defended it twenty-five times. Both are still records.",
   "visual": {
    "kind": "photo",
    "image": "standing",
    "focus": [
     0.17,
     0.35
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.45
    ]
   }
  },
  {
   "id": "war",
   "text": "Then came the war. In 1942 he gave the purses from two title fights to the Navy and Army relief funds, and joined the Army.",
   "visual": {
    "kind": "photo",
    "image": "army",
    "focus": [
     0.5,
     0.3
    ],
    "zoom": [
     1.05,
     1.15
    ],
    "anchor": [
     0.5,
     0.45
    ]
   },
   "section": "war",
   "overlays": {
    "stamp": "1942"
   }
  },
  {
   "id": "troops",
   "text": "He fought almost a hundred exhibitions for the troops.",
   "visual": {
    "kind": "card",
    "image": "alston",
    "caption": "Sgt. Joe Louis, Office of War Information, 1943"
   }
  },
  {
   "id": "taxed",
   "text": "But the government counted the money he gave away as his income.",
   "visual": {
    "kind": "title",
    "title": "Taxed",
    "sub": "on the money he gave away"
   },
   "section": "debt"
  },
  {
   "id": "debt",
   "text": "His tax bill kept growing. With interest and penalties, it passed one million dollars.",
   "visual": {
    "kind": "photo",
    "image": "p1951",
    "focus": [
     0.5,
     0.35
    ],
    "zoom": [
     1.1,
     1.2
    ],
    "anchor": [
     0.5,
     0.45
    ]
   }
  },
  {
   "id": "comeback",
   "text": "So he came back to the ring in his late thirties. He lost to Ezzard Charles.",
   "visual": {
    "kind": "card",
    "image": "charles",
    "caption": "Ezzard Charles vs. Joe Louis, 1950"
   },
   "overlays": {
    "stamp": "1950"
   }
  },
  {
   "id": "marciano",
   "text": "Then, in 1951, Rocky Marciano knocked him out of the ring. He never fought again.",
   "visual": {
    "kind": "video",
    "clip": "ropes",
    "focus": [
     0.5,
     0.5
    ],
    "zoom": [
     1.0,
     1.06
    ],
    "anchor": [
     0.5,
     0.5
    ]
   },
   "overlays": {
    "stamp": "October 26, 1951"
   }
  },
  {
   "id": "greeter",
   "text": "He became a pro wrestler. Later, he worked as a greeter at Caesars Palace in Las Vegas.",
   "visual": {
    "kind": "video",
    "clip": "marciano",
    "focus": [
     0.5,
     0.45
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.45
    ]
   },
   "section": "after"
  },
  {
   "id": "friend",
   "text": "Max Schmeling, the man he beat in 1938, became his friend.",
   "visual": {
    "kind": "card",
    "image": "schmeling71",
    "caption": "Joe Louis and Max Schmeling, 1971"
   }
  },
  {
   "id": "death",
   "text": "Joe Louis died on April 12th, 1981. He was 66.",
   "visual": {
    "kind": "photo",
    "image": "vanvechten",
    "focus": [
     0.5,
     0.28
    ],
    "zoom": [
     1.2,
     1.3
    ],
    "anchor": [
     0.5,
     0.45
    ]
   },
   "overlays": {
    "stamp": "April 12, 1981"
   },
   "section": "end"
  },
  {
   "id": "arlington",
   "text": "President Reagan waived the rules so he could be buried at Arlington National Cemetery, with full military honors. Max Schmeling was a pallbearer.",
   "visual": {
    "kind": "title",
    "title": "Arlington",
    "sub": "full military honors, 1981"
   }
  },
  {
   "id": "medal",
   "text": "The next year, Congress awarded him its Gold Medal.",
   "visual": {
    "kind": "card",
    "image": "medal",
    "caption": "Joe Louis Congressional Gold Medal"
   }
  },
  {
   "id": "close",
   "text": "That was Joe Louis.",
   "visual": {
    "kind": "video",
    "clip": "crowd37",
    "focus": [
     0.5,
     0.5
    ],
    "zoom": [
     1.0,
     1.08
    ],
    "anchor": [
     0.5,
     0.5
    ]
   }
  },
  {
   "id": "cta",
   "text": "Follow The Black History Room for more.",
   "visual": {
    "kind": "endcard"
   },
   "section": "cta",
   "captions": false
  }
 ],
